<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HairSalonPOS.Wpf.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="LoginTemplate">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate x:Key="CashierTemplate">
                <views:CashierView/>
            </DataTemplate>
            <DataTemplate x:Key="InventoryTemplate">
                <views:InventoryView/>
            </DataTemplate>
            <DataTemplate x:Key="ReportsTemplate">
                <views:ReportsView/>
            </DataTemplate>
            <DataTemplate x:Key="CustomersTemplate">
                <views:CustomersView/>
            </DataTemplate>
            <DataTemplate x:Key="StaffTemplate">
                <views:StaffView/>
            </DataTemplate>
            <DataTemplate x:Key="DiscountsTemplate">
                <views:DiscountsView/>
            </DataTemplate>
            <DataTemplate x:Key="AppointmentsTemplate">
                <views:AppointmentsView/>
            </DataTemplate>
            <DataTemplate x:Key="SettingsTemplate">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
