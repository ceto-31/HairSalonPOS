<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HairSalonPOS.Wpf.Helpers"
        Title="Cindy Hair Salon POS" Height="780" Width="1280" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <helpers:ViewTemplateSelector x:Key="ViewSelector"
            LoginTemplate="{StaticResource LoginTemplate}"
            CashierTemplate="{StaticResource CashierTemplate}"
            InventoryTemplate="{StaticResource InventoryTemplate}"
            ReportsTemplate="{StaticResource ReportsTemplate}"
            CustomersTemplate="{StaticResource CustomersTemplate}"
            StaffTemplate="{StaticResource StaffTemplate}"
            DiscountsTemplate="{StaticResource DiscountsTemplate}"
            AppointmentsTemplate="{StaticResource AppointmentsTemplate}"
            SettingsTemplate="{StaticResource SettingsTemplate}"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock Text="Cindy Hair Salon POS" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Cashier" Style="{StaticResource NavButton}" Command="{Binding NavigateCashierCommand}" Margin="0,0,4,0"/>
                    <Button Content="Inventory" Style="{StaticResource NavButton}" Command="{Binding NavigateInventoryCommand}" Margin="0,0,4,0"/>
                    <Button Content="Reports" Style="{StaticResource NavButton}" Command="{Binding NavigateReportsCommand}" Margin="0,0,4,0"/>
                    <Button Content="Customers" Style="{StaticResource NavButton}" Command="{Binding NavigateCustomersCommand}" Margin="0,0,4,0"/>
                    <Button Content="Staff" Style="{StaticResource NavButton}" Command="{Binding NavigateStaffCommand}"
                            Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0"/>
                    <Button Content="Discounts" Style="{StaticResource NavButton}" Command="{Binding NavigateDiscountsCommand}"
                            Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0"/>
                    <Button Content="Appointments" Style="{StaticResource NavButton}" Command="{Binding NavigateAppointmentsCommand}" Margin="0,0,4,0"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}" Command="{Binding NavigateSettingsCommand}"
                            Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Foreground="#D6D3D1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="Logout" Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource AlertBrush}" Padding="14,8"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="#92400E">
                <Run Text="{Binding StatusText, Mode=OneWay}"/>
                <Run Text="  |  "/>
                <Run Text="{Binding LowStockAlertText, Mode=OneWay}"/>
                <Run Text="  |  "/>
                <Run Text="{Binding CurrentDateText, Mode=OneWay}"/>
            </TextBlock>
        </Border>

        <ContentControl Margin="16" Content="{Binding CurrentView}" ContentTemplateSelector="{StaticResource ViewSelector}"/>
    </DockPanel>
</Window>
