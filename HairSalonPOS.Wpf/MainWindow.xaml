<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HairSalonPOS.Wpf.Helpers"
        Title="Fix Republic" Height="780" Width="1280" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">
    <Window.Resources>
        <helpers:ViewTemplateSelector x:Key="ViewSelector"
            LoginTemplate="{StaticResource LoginTemplate}"
            CashierTemplate="{StaticResource CashierTemplate}"
            InventoryTemplate="{StaticResource InventoryTemplate}"
            ReportsTemplate="{StaticResource ReportsTemplate}"
            CustomersTemplate="{StaticResource CustomersTemplate}"
            StaffTemplate="{StaticResource StaffTemplate}"
            DiscountsTemplate="{StaticResource DiscountsTemplate}"
            AppointmentsTemplate="{StaticResource AppointmentsTemplate}"
            SettingsTemplate="{StaticResource SettingsTemplate}"/>
    </Window.Resources>

    <DockPanel>
        <!-- Top header (logged in only) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ShellHeaderBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HamburgerButton}" Command="{Binding ToggleDrawerCommand}"
                            ToolTip="Open menu" Margin="0,0,10,0"/>
                    <TextBlock Text="Fix Republic." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,16,0">
                    <TextBlock Text="{Binding GreetingText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding HeaderDateTimeText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding AppointmentsHeaderText}" Style="{StaticResource HeaderStatText}"/>
                    <TextBlock Text="{Binding LowStockHeaderText}" Style="{StaticResource HeaderStatText}"/>
                    <TextBlock Text="{Binding BusinessHoursHeaderText}" Style="{StaticResource HeaderStatText}" Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="{Binding ThemeToggleLabel}" Style="{StaticResource ThemeToggleButton}"
                                  IsChecked="{Binding IsDarkMode}" Margin="0,0,8,0"
                                  ToolTip="Toggle dark mode"/>
                    <Button Content="Logout" Style="{StaticResource SecondaryButton}" Padding="14,8" MinHeight="36"
                            FontSize="13" Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <ContentControl Margin="{Binding ContentMargin}"
                            Content="{Binding CurrentView}"
                            ContentTemplateSelector="{StaticResource ViewSelector}"/>

            <!-- Nav drawer overlay -->
            <Grid Panel.ZIndex="100"
                  Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource DrawerOverlayButton}"
                        Command="{Binding CloseDrawerCommand}"/>

                <Border Width="260" HorizontalAlignment="Left" Background="{DynamicResource DrawerBackgroundBrush}"
                        BorderBrush="{DynamicResource DrawerBorderBrush}" BorderThickness="0,0,1,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Direction="0"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Menu" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="16,20,16,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,16">
                                <Button Content="CASHIER" Command="{Binding NavigateCashierCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Cashier">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"/>

                                <Button Content="INVENTORY" Command="{Binding NavigateInventoryCommand}"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Inventory">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}"/>

                                <Button Content="REPORTS" Command="{Binding NavigateReportsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Reports">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"/>

                                <Button Content="CUSTOMERS" Command="{Binding NavigateCustomersCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Customers">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"/>

                                <Button Content="STAFF" Command="{Binding NavigateStaffCommand}"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Staff">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}"/>

                                <Button Content="DISCOUNTS" Command="{Binding NavigateDiscountsCommand}"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Discounts">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}"/>

                                <Button Content="APPOINTMENTS" Command="{Binding NavigateAppointmentsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Appointments">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Border Height="1" Background="#E7E5E4" Margin="16,0"/>

                                <Button Content="SETTINGS" Command="{Binding NavigateSettingsCommand}"
                                        Visibility="{Binding CanViewAdminScreens, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DrawerNavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNavKey}" Value="Settings">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
