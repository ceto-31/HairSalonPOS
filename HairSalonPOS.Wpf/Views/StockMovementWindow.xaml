<Window x:Class="Views.StockMovementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock movement"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="OverlayScrim"
                Background="{DynamicResource DialogOverlayBrush}"
                PreviewMouseDown="OverlayScrim_PreviewMouseDown"/>

        <Grid x:Name="DialogContent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="400"
              MaxWidth="460"
              PreviewMouseDown="DialogContent_PreviewMouseDown">
            <Border Style="{StaticResource FloatingDialogSurface}">
                <StackPanel>
                    <Border x:Name="AccentBar" Height="4" CornerRadius="2" Margin="0,0,0,16"
                            Background="{DynamicResource LinkStockInBrush}" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="TitleText"
                               Text="Stock in"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <StackPanel x:Name="ReserveModePanel" Visibility="Collapsed" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                        <RadioButton x:Name="ReserveRadio" Content="Add to reserve stock" IsChecked="True" GroupName="ReserveMode"
                                     Checked="ReserveMode_Changed"/>
                        <RadioButton x:Name="ReleaseRadio" Content="Use reserve stock" Margin="16,0,0,0" GroupName="ReserveMode"
                                     Checked="ReserveMode_Changed"/>
                    </StackPanel>

                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="8" Margin="0,0,14,0"
                                Background="{DynamicResource CardMutedBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8"/>
                            </Border.Clip>
                            <Grid>
                                <TextBlock x:Name="PhotoPlaceholder" Text="—" FontSize="16"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ProductPhoto" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProductNameText" FontWeight="SemiBold" FontSize="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ProductMetaText" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Quantity" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="−" Width="44" MinHeight="40"
                                Style="{StaticResource SecondaryButton}" Click="Minus_Click" Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right" Content="+" Width="44" MinHeight="40"
                                Style="{StaticResource SecondaryButton}" Click="Plus_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="QtyBox" Style="{StaticResource ModernTextBox}"
                                 Text="1" TextAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                 VerticalContentAlignment="Center"
                                 PreviewTextInput="QtyBox_PreviewTextInput"
                                 TextChanged="QtyBox_TextChanged"/>
                    </DockPanel>
                    <TextBlock x:Name="PreviewText" FontSize="13" Margin="0,0,0,14"
                               Foreground="{DynamicResource MutedTextBrush}"/>

                    <TextBlock Text="Reason" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ReasonBox" Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,12"/>

                    <TextBlock Text="Notes (optional)" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox x:Name="NotesBox" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,8"/>

                    <TextBlock x:Name="ErrorText" FontSize="13" Margin="0,0,0,12"
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                MinHeight="36" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource PrimaryButton}"
                                Padding="16,8" MinHeight="36" Click="Confirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
