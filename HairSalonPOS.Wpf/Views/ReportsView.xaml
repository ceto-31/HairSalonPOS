<UserControl x:Class="Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HairSalonPOS.Wpf.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Sales Reports" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Analyze sales performance by period" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Daily" Command="{Binding SetDailyCommand}" Style="{StaticResource PillTabButton}" Margin="0,0,8,0"/>
                <Button Content="Weekly" Command="{Binding SetWeeklyCommand}" Style="{StaticResource PillTabButton}" Margin="0,0,8,0"/>
                <Button Content="Monthly" Command="{Binding SetMonthlyCommand}" Style="{StaticResource PillTabButton}" Margin="0,0,16,0"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="160" VerticalAlignment="Center"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
                <Button Content="Export" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" Margin="12,0,0,0"/>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Transactions" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TransactionCount}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Total sales" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TotalSales, StringFormat=₱{0:N0}}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Avg transaction" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding AverageSale, StringFormat=₱{0:N0}}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Top service" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TopService}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <views:SalesLineChartView DataContext="{Binding DailyChart}"/>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4,0">
                    <views:SalesLineChartView DataContext="{Binding WeeklyChart}"/>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <views:SalesLineChartView DataContext="{Binding YearlyChart}"/>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Revenue by service" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding RevenueBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0" Width="70" VerticalAlignment="Bottom">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6,6,0,0"
                                                Height="{Binding BarHeight}" VerticalAlignment="Bottom" MinHeight="8" Opacity="0.85"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Amount, StringFormat=₱{0:N0}}" FontSize="10" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Stylist performance" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding StylistPerformance}" Style="{StaticResource DataGridStyle}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stylist" Binding="{Binding StylistName}" Width="*"/>
                                <DataGridTextColumn Header="Services" Binding="{Binding ServiceCount}" Width="80"/>
                                <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat=₱{0:N0}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Transaction list" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"/>
                    <DataGrid ItemsSource="{Binding Sales}" Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sale #" Binding="{Binding ReceiptNumber}" Width="80"/>
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding SaleDate, StringFormat='M/d h:mm tt'}" Width="120"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="90"/>
                            <DataGridTextColumn Header="Stylist" Binding="{Binding StylistName}" Width="90"/>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="70"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=₱{0:N0}}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
