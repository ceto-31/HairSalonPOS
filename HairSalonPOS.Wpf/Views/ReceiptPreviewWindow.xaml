<Window x:Class="Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview" Height="640" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBackgroundBrush}">
    <DockPanel Margin="16">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PrintButton" Content="Print" Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="0,0,8,0" Click="PrintButton_Click"/>
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Padding="20,8" IsCancel="True"/>
        </StackPanel>
        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
            <FlowDocumentScrollViewer x:Name="ReceiptViewer" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </DockPanel>
</Window>
