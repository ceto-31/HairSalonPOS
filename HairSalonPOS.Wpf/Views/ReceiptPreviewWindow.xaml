<Window x:Class="Views.ReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Preview" Height="640" Width="420" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBackgroundBrush}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch">
            <Border x:Name="ReceiptPaperBorder"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <FlowDocumentScrollViewer x:Name="ReceiptViewer"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Hidden"
                                          IsToolBarVisible="False"
                                          Background="Transparent"
                                          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"/>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PrintButton" Content="Print" Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="0,0,8,0" Click="PrintButton_Click"/>
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Padding="20,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
