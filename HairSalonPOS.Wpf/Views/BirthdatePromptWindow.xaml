<Window x:Class="Views.BirthdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify senior discount"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border Background="{DynamicResource DialogOverlayBrush}"/>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="360"
              MaxWidth="420">
            <Border Style="{StaticResource FloatingDialogSurface}">
                <StackPanel>
                    <TextBlock Text="Verify senior discount"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Select the customer's birthdate to confirm senior eligibility (60+)."
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="Birthdate" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="BirthdatePicker"
                                Style="{StaticResource ModernDatePicker}"
                                SelectedDateFormat="Short"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                MinHeight="36" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Confirm" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                MinHeight="36" Click="Confirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
