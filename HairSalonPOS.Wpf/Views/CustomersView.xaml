<UserControl x:Class="Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Add customer" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Width="220" Margin="0,0,12,0">
                        <TextBlock Text="Name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditName}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Width="180">
                        <TextBlock Text="Phone" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditPhone}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomerCommand}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="All customers" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                 Style="{StaticResource ModernTextBox}" Tag="Search name or phone..." Margin="0,0,12,0"/>
                        <Button Content="+ Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCustomerCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}"/>
                <ListBox ItemsSource="{Binding Customers}" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardMutedBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#ECFDF5" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Phone}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding VisitCount}"/>
                                            <Run Text=" visits"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding LoyaltyPoints}"/>
                                            <Run Text=" pts"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
