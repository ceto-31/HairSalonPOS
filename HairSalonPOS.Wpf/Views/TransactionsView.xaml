<UserControl x:Class="Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Transactions" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Browse and reprint past sales" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBox}" Width="260" Margin="0,0,12,0"
                             Tag="Search transactions..."/>
                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="All" Command="{Binding SetAllCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAll}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Today" Command="{Binding SetDailyCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDaily}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="This week" Command="{Binding SetWeeklyCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWeekly}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="This month" Command="{Binding SetMonthlyCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonthly}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="This year" Command="{Binding SetYearlyCommand}" Margin="0,0,16,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsYearly}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <DatePicker SelectedDate="{Binding SelectedDate, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource LargeDatePicker}" VerticalAlignment="Center"/>
            </StackPanel>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Transactions" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TransactionCount}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Total sales" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TotalSales, StringFormat=₱{0:N0}}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Avg transaction" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding AverageSale, StringFormat=₱{0:N0}}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Transaction history" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"/>
                    <DataGrid x:Name="TransactionsGrid" ItemsSource="{Binding Sales}" Style="{StaticResource DataGridStyle}"
                              MouseDoubleClick="TransactionsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="90"/>
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding SaleDate, StringFormat='M/d h:mm tt'}" Width="120"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="90"/>
                            <DataGridTextColumn Header="Stylist" Binding="{Binding StylistName}" Width="90"/>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="70"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=₱{0:N0}}" Width="90"/>
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Preview" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.PreviewReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Reprint" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                                    Command="{Binding DataContext.ReprintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
