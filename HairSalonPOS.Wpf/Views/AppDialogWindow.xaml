<Window x:Class="Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Storyboard x:Key="OpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="Overlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="DialogScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.94" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.94" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.18"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="Overlay" Background="{DynamicResource DialogOverlayBrush}" Opacity="0"/>

        <Grid x:Name="DialogCard"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="360"
              MaxWidth="460"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DialogScale" ScaleX="0.94" ScaleY="0.94"/>
            </Grid.RenderTransform>

            <Border Style="{StaticResource FloatingDialogSurface}">
                <StackPanel>
                    <Border x:Name="IconCircle"
                            Width="56" Height="56"
                            CornerRadius="28"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <TextBlock x:Name="IconText"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TitleText"
                               Text="Title"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="MessageText"
                               Text="Message"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Margin="0,0,0,24"/>

                    <Grid x:Name="ButtonPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SecondaryButton"
                                Grid.Column="0"
                                Style="{StaticResource DialogSecondaryButton}"
                                Click="SecondaryButton_Click"/>

                        <Button x:Name="PrimaryButton"
                                Grid.Column="2"
                                Style="{StaticResource DialogPrimaryButton}"
                                IsDefault="True"
                                Click="PrimaryButton_Click"/>
                    </Grid>

                    <Button x:Name="SingleButton"
                            Style="{StaticResource DialogPrimaryButton}"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Click="PrimaryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
