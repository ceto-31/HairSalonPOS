<UserControl x:Class="Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="640" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Add / Edit Product" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="SKU" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditSku}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Product name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditName}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Brand" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditBrand}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Price" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditPrice}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Cost" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditCost}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Qty on hand" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditQty}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Reorder level" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditReorder}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save product" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProductCommand}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Inventory Management" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Add product" Style="{StaticResource PrimaryButton}" Command="{Binding AddProductCommand}" Margin="0,0,8,0"/>
                            <Button Content="Edit selected" Style="{StaticResource SecondaryButton}" Command="{Binding EditProductCommand}" Margin="0,0,8,0"/>
                            <Button Content="Export" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280"
                                 Style="{StaticResource ModernTextBox}" Tag="Search products..."/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Products" Command="{Binding ShowProductsTabCommand}" Style="{StaticResource PillTabButton}" Margin="0,0,8,0"/>
                        <Button Content="Stock movement log" Command="{Binding ShowMovementLogCommand}" Style="{StaticResource PillTabButton}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}"/>

                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          Style="{StaticResource DataGridStyle}" RowStyle="{StaticResource LowStockRowStyle}"
                          Visibility="{Binding ShowProductsTab, Converter={StaticResource BoolToVis}}"
                          CellEditEnding="ProductsGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="70"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="90"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=₱{0:N2}}" Width="80"/>
                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=₱{0:N2}}" Width="80"/>
                        <DataGridTextColumn Header="Qty on hand" Binding="{Binding StockOnHand, UpdateSourceTrigger=PropertyChanged}" Width="90" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel}" Width="80"/>
                        <DataGridTemplateColumn Header="Status" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Edit" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                                            Command="{Binding DataContext.EditProductRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding Movements}" Style="{StaticResource DataGridStyle}"
                          Visibility="{Binding ShowMovementLog, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date/Time" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="70"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Change" Binding="{Binding ChangeQty}" Width="70"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="90"/>
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
