<UserControl x:Class="Views.SalesLineChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="220" d:DesignWidth="320">
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
        <Grid Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="8,8,8,4">
                <Grid>
                    <TextBlock Text="{Binding MaxAmountLabel}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0"/>
                    <Canvas Width="304" Height="120" HorizontalAlignment="Center">
                        <Line X1="0" Y1="120" X2="304" Y2="120" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                        <Line X1="0" Y1="60" X2="304" Y2="60" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1" Opacity="0.5"/>
                        <Path Data="{Binding CurveGeometry}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2.5"
                              StrokeLineJoin="Round"
                              Fill="Transparent"/>
                        <ItemsControl ItemsSource="{Binding Points}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding MarkerLeft}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding MarkerTop}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="8" Height="8"
                                             Fill="{DynamicResource AccentBrush}"
                                             Stroke="{DynamicResource CardBackgroundBrush}"
                                             StrokeThickness="1.5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Points}" Margin="8,6,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Points.Count}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="10" TextAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Amount, StringFormat=₱{0:N0}}" FontSize="9" TextAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </StackPanel>
</UserControl>
