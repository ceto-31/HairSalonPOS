<UserControl x:Class="Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HairSalonPOS.Wpf.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Today's salon overview" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Today's sales" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TodaySales, StringFormat=₱{0:N0}}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Transactions today" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding TransactionCount}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="Appointments today" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding AppointmentCount}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Low stock items" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <views:SalesLineChartView DataContext="{Binding DailyChart}"/>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4,0">
                    <views:SalesLineChartView DataContext="{Binding WeeklyChart}"/>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <views:SalesLineChartView DataContext="{Binding YearlyChart}"/>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Today's appointments" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Appointments}" Style="{StaticResource DataGridStyle}" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeLabel}" Width="80"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*"/>
                                <DataGridTextColumn Header="Stylist" Binding="{Binding StaffName}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recent sales" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Last 5 transactions today" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding RecentSales}" Style="{StaticResource DataGridStyle}" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="80"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeLabel}" Width="80"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=₱{0:N0}}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding HasLowStockAlerts, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Low stock alerts" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding LowStockAlerts}" Style="{StaticResource DataGridStyle}" MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="On hand" Binding="{Binding StockOnHand}" Width="80"/>
                            <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
