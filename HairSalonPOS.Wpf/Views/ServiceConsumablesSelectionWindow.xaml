<Window x:Class="Views.ServiceConsumablesSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select products"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="OverlayScrim"
                Background="{DynamicResource DialogOverlayBrush}"
                PreviewMouseDown="OverlayScrim_PreviewMouseDown"/>

        <Grid x:Name="DialogContent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="420"
              MaxWidth="560"
              PreviewMouseDown="DialogContent_PreviewMouseDown">
            <Border Style="{StaticResource FloatingDialogSurface}">
                <StackPanel>
                    <Border Height="4" CornerRadius="2" Margin="0,0,0,16"
                            Background="{DynamicResource AccentBrush}" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="TitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="SubtitleText"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernTextBox}"
                             Tag="Search products..."
                             Margin="0,0,0,8"
                             TextChanged="SearchBox_TextChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select all" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"
                                Click="SelectAll_Click"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                Click="Clear_Click"/>
                    </StackPanel>

                    <Border Background="{DynamicResource NavActiveBackgroundBrush}"
                            CornerRadius="10"
                            Padding="8"
                            MaxHeight="320"
                            Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ProductsPanel"/>
                        </ScrollViewer>
                    </Border>

                    <Grid x:Name="PickOneDefaultQtyPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default qty per choice" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="DefaultQtyBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <TextBlock x:Name="ErrorText" FontSize="13" Margin="0,0,0,12"
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                MinHeight="36" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                MinHeight="36" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
