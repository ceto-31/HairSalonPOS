<Window x:Class="Views.ServiceConsumablePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select products used"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="OverlayScrim"
                Background="{DynamicResource DialogOverlayBrush}"
                PreviewMouseDown="OverlayScrim_PreviewMouseDown"/>

        <Grid x:Name="DialogContent"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="400"
              MaxWidth="480"
              PreviewMouseDown="DialogContent_PreviewMouseDown">
            <Border Style="{StaticResource FloatingDialogSurface}">
                <StackPanel>
                    <Border Height="4" CornerRadius="2" Margin="0,0,0,16"
                            Background="{DynamicResource AccentBrush}" HorizontalAlignment="Stretch"/>

                    <TextBlock x:Name="TitleText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Choose the product used for this service. Inventory will deduct on checkout."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <ItemsControl x:Name="SlotsPanel" Margin="0,0,0,12"/>

                    <TextBlock x:Name="ErrorText" FontSize="13" Margin="0,0,0,12"
                               Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="16,8"
                                MinHeight="36" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Content="Confirm" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                MinHeight="36" Click="Confirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
