<Window x:Class="Views.InventoryProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="OverlayScrim"
                Background="{DynamicResource DialogOverlayBrush}"
                PreviewMouseDown="OverlayScrim_PreviewMouseDown"/>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="480"
              MaxWidth="560"
              MaxHeight="720"
              Margin="24">
            <Border Style="{StaticResource FloatingDialogSurface}" MaxHeight="720">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SecondaryButton}"
                                Width="36" Height="36" Padding="0" Click="Close_Click"
                                ToolTip="Close"/>
                        <TextBlock Text="Product details" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding SelectedProduct}">
                            <DockPanel Margin="0,0,0,16">
                                <Border DockPanel.Dock="Left" Width="88" Height="88" CornerRadius="10" Margin="0,0,14,0"
                                        Background="{DynamicResource CardMutedBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,88,88" RadiusX="10" RadiusY="10"/>
                                    </Border.Clip>
                                    <Grid>
                                        <TextBlock Text="{Binding PlaceholderIcon}" FontSize="40"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding ImagePath, Converter={StaticResource CatalogImagePath}}"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0">
                                        <Run Text="SKU "/>
                                        <Run Text="{Binding Sku, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"
                                               Visibility="{Binding Brand, Converter={StaticResource StringNotEmptyToVis}}">
                                        <Run Text="{Binding Brand, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0">
                                        <Run Text="₱"/>
                                        <Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>

                            <Border Background="{DynamicResource WarningBadgeBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,14"
                                    Visibility="{Binding ShowStockWarning, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StockWarningMessage}" TextWrapping="Wrap" FontSize="13"/>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Border Style="{StaticResource InventoryStatCard}">
                                    <StackPanel>
                                        <TextBlock Text="On hand" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding StockOnHand}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InventoryStatCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Reorder at" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="{Binding ReorderLevel}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InventoryStatCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Status" Style="{StaticResource SectionHeader}"/>
                                        <Border Style="{StaticResource StockStatusPill}" Margin="0,6,0,0"
                                                Background="{Binding StockStatus, Converter={StaticResource StockStatusBg}}">
                                            <TextBlock Text="{Binding StockStatus}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{Binding StockStatus, Converter={StaticResource StockStatusFg}}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding StockOnHand, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding ReorderLevel, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Stock level" Style="{StaticResource SectionHeader}"/>
                                </DockPanel>
                                <Grid x:Name="stockBarTrack" Height="8">
                                    <Border Background="{DynamicResource CardMutedBrush}" CornerRadius="4"/>
                                    <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                            Background="{Binding StockStatus, Converter={StaticResource StockLevelBarFill}}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                <Binding ElementName="stockBarTrack" Path="ActualWidth"/>
                                                <Binding Path="StockLevelFillRatio"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="StockInButton" Content="Stock in" Style="{StaticResource StockInCtaButton}"
                                        MinWidth="110" Margin="0,0,8,0" Click="StockIn_Click"/>
                                <Button x:Name="StockOutButton" Content="Stock out" Style="{StaticResource StockOutCtaButton}"
                                        MinWidth="110" Margin="0,0,8,0" Click="StockOut_Click"/>
                                <Button x:Name="CreateOrderButton" Content="Create order" Style="{StaticResource PrimaryButton}"
                                        MinWidth="120" Padding="14,8" Click="CreateOrder_Click"
                                        Visibility="{Binding ShowStockWarning, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="14,8" MinHeight="36"
                                        Click="Edit_Click" Margin="0,0,8,0"/>
                                <Button Content="Delete" Style="{StaticResource SecondaryButton}" Padding="14,8" MinHeight="36"
                                        Click="Delete_Click"/>
                            </StackPanel>

                            <TextBlock Text="Recent movements" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="NoMovementsText" Text="No stock movements yet."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="MovementsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeQty, StringFormat={}{0:+#;-#;0}}"
                                                       FontWeight="SemiBold"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding MovementType}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
                                                    <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat=g}"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding Notes, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
