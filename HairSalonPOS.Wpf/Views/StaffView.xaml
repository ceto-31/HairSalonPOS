<UserControl x:Class="Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HairSalonPOS.Wpf.Helpers"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="700">
    <Grid>
        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Button Content="← Back" Style="{StaticResource SecondaryButton}" Padding="10,6"
                            Command="{Binding CancelEditCommand}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="16"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" Width="120" Margin="0,0,20,0" VerticalAlignment="Top">
                        <Grid Width="120" Height="120">
                            <Border Width="120" Height="120" CornerRadius="60"
                                    Background="{DynamicResource AvatarBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                            <Image Source="pack://application:,,,/Assets/Icons/icon_person.png"
                                   Width="48" Height="48" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasEditImage, Converter={StaticResource InverseBoolToVis}}"/>
                            <Image Stretch="UniformToFill"
                                   Source="{Binding EditImagePath, Converter={StaticResource CatalogImagePath}}"
                                   Visibility="{Binding HasEditImage, Converter={StaticResource BoolToVis}}">
                                <Image.Clip>
                                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <Button Content="{Binding ChooseImageLabel}" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding ChooseImageCommand}"/>
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding RemoveImageCommand}"
                                Visibility="{Binding HasEditImage, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="First name" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding EditFirstName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ValidatedModernTextBox}"
                                         helpers:FormValidation.HasError="{Binding EditFirstNameError, Converter={StaticResource StringNotEmptyToBool}}"/>
                                <TextBlock Text="{Binding EditFirstNameError}"
                                           Style="{StaticResource StaffFormFieldError}"
                                           Visibility="{Binding EditFirstNameError, Converter={StaticResource StringNotEmptyToVis}}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Last name" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding EditLastName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ValidatedModernTextBox}"
                                         helpers:FormValidation.HasError="{Binding EditLastNameError, Converter={StaticResource StringNotEmptyToBool}}"/>
                                <TextBlock Text="{Binding EditLastNameError}"
                                           Style="{StaticResource StaffFormFieldError}"
                                           Visibility="{Binding EditLastNameError, Converter={StaticResource StringNotEmptyToVis}}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Role" Style="{StaticResource SectionHeader}"/>
                            <TextBox Text="{Binding EditRole}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Contact number" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding EditContactNumber, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="11"
                                         Style="{StaticResource ValidatedModernTextBox}"
                                         helpers:FormValidation.HasError="{Binding EditContactNumberError, Converter={StaticResource StringNotEmptyToBool}}"/>
                                <TextBlock Text="{Binding EditContactNumberError}"
                                           Style="{StaticResource StaffFormFieldError}"
                                           Visibility="{Binding EditContactNumberError, Converter={StaticResource StringNotEmptyToVis}}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Email (Optional)" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ValidatedModernTextBox}"
                                         helpers:FormValidation.HasError="{Binding EditEmailError, Converter={StaticResource StringNotEmptyToBool}}"/>
                                <TextBlock Text="{Binding EditEmailError}"
                                           Style="{StaticResource StaffFormFieldError}"
                                           Visibility="{Binding EditEmailError, Converter={StaticResource StringNotEmptyToVis}}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveStaffCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Staff" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding ShowArchivedLabel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding ToggleShowArchivedCommand}"/>
                        <Button Content="+ Add staff" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddStaffCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding StaffMembers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="44" Height="44" Margin="0,0,14,0">
                                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AvatarBackgroundBrush}">
                                                <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="{DynamicResource AvatarForegroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Border>
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding ImagePath, Converter={StaticResource CatalogImagePath}}"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Role}" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                                <Run Text="{Binding ContactNumber, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Email, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource StatusOkBadge}" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        </Border>
                                        <Button Grid.Column="3" Content="Edit" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                                Command="{Binding DataContext.EditStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="4" Padding="12,6" Margin="0,0,8,0" Content="Archive"
                                                Command="{Binding DataContext.ArchiveStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="4" Padding="12,6" Margin="0,0,8,0" Content="Restore"
                                                Command="{Binding DataContext.UnarchiveStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="5" Content="Delete" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                Command="{Binding DataContext.DeleteStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
