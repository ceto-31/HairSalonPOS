<UserControl x:Class="Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Add staff member" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditName}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Role" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditRole}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Commission %" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditCommission}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveStaffCommand}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Staff management" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="+ Add staff" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Command="{Binding AddStaffCommand}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}"/>
                <ItemsControl ItemsSource="{Binding StaffMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E7E5E4" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#DBEAFE" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="#2563EB"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Role}"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding CommissionRate}"/>
                                            <Run Text="% commission"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusOkBadge}" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Active" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}"/>
                                    </Border>
                                    <Button Grid.Column="3" Content="Delete" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                            Command="{Binding DataContext.DeleteStaffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
