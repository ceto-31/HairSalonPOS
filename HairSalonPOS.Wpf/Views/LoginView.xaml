<UserControl x:Class="Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="800">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Border Style="{StaticResource LoginCardBorder}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Style="{StaticResource LoginHeaderBlock}">
                    <Grid Width="100" Height="100"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ClipToBounds="True">
                        <Grid.OpacityMask>
                            <VisualBrush Stretch="None">
                                <VisualBrush.Visual>
                                    <Grid Width="100" Height="100">
                                        <Ellipse Width="100" Height="100" Fill="Black"/>
                                    </Grid>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Grid.OpacityMask>
                        <Image Width="210" Height="210"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/Assets/pos_LOGO.png"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="POS with Inventory Management System"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               MaxWidth="320"
                               LineHeight="18"/>
                </StackPanel>

                <!-- Login -->
                <StackPanel Visibility="{Binding IsLoginStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Sign in to continue" Style="{StaticResource LoginStepSubtitle}"/>

                    <TextBlock Text="Username" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorder}">
                        <TextBox x:Name="LoginUsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginInlineTextBox}"
                                 IsEnabled="{Binding IsLoginStep}"/>
                    </Border>

                    <TextBlock Text="Password" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorder}">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="0"
                                         Style="{StaticResource LoginPasswordBox}"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                            <TextBox x:Name="PasswordTextBox" Grid.Column="0"
                                     Style="{StaticResource LoginPasswordRevealTextBox}"
                                     Visibility="Collapsed"
                                     TextChanged="PasswordTextBox_TextChanged"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PasswordRevealButton}"
                                          Checked="PasswordReveal_Checked" Unchecked="PasswordReveal_Unchecked"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Style="{StaticResource LoginMessage}"/>
                    <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource LoginMessage}"/>
                    <Button Content="Login" Style="{StaticResource LoginPrimaryButton}" Command="{Binding LoginCommand}"/>
                    <Button Content="Forgot password?" Command="{Binding ShowForgotPasswordCommand}" Style="{StaticResource LoginLinkButton}"/>
                </StackPanel>

                <!-- Username step -->
                <StackPanel Visibility="{Binding IsUsernameStep, Converter={StaticResource BoolToVis}}">
                    <DockPanel Style="{StaticResource LoginBackRow}">
                        <Button Content="← Back" Command="{Binding RecoveryBackCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
                    </DockPanel>
                    <TextBlock Text="Forgot password" Style="{StaticResource LoginStepTitle}"/>
                    <TextBlock Text="Enter your username to continue." Style="{StaticResource LoginStepDescription}"/>

                    <TextBlock Text="Username" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorder}">
                        <TextBox x:Name="RecoveryUsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginInlineTextBox}"
                                 IsEnabled="{Binding IsUsernameStep}"/>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Style="{StaticResource LoginMessage}"/>
                    <Button Content="Next" Style="{StaticResource LoginPrimaryButton}" Command="{Binding RecoveryNextCommand}"/>
                </StackPanel>

                <!-- Security questions -->
                <StackPanel Visibility="{Binding IsSecurityStep, Converter={StaticResource BoolToVis}}">
                    <DockPanel Style="{StaticResource LoginBackRow}">
                        <Button Content="← Back" Command="{Binding RecoveryBackCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
                    </DockPanel>
                    <TextBlock Text="Security questions" Style="{StaticResource LoginStepTitle}"/>
                    <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource LoginStepDescription}"/>

                    <TextBlock Text="Favorite number" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorderCompact}">
                        <TextBox Text="{Binding FavNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LoginInlineTextBox}"/>
                    </Border>
                    <TextBlock Text="{Binding FavNumberError}" Style="{StaticResource LoginFieldError}"/>

                    <TextBlock Text="Favorite color" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorderCompact}">
                        <TextBox Text="{Binding FavColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LoginInlineTextBox}"/>
                    </Border>
                    <TextBlock Text="{Binding FavColorError}" Style="{StaticResource LoginFieldError}"/>

                    <TextBlock Text="Favorite animal" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorderCompact}">
                        <TextBox Text="{Binding FavAnimal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LoginInlineTextBox}"/>
                    </Border>
                    <TextBlock Text="{Binding FavAnimalError}" Style="{StaticResource LoginFieldError}"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Style="{StaticResource LoginMessage}"/>
                    <Button Content="Verify" Style="{StaticResource LoginPrimaryButton}" Command="{Binding RecoveryNextCommand}"/>
                </StackPanel>

                <!-- Reset password -->
                <StackPanel Visibility="{Binding IsResetStep, Converter={StaticResource BoolToVis}}">
                    <DockPanel Style="{StaticResource LoginBackRow}">
                        <Button Content="← Back" Command="{Binding RecoveryBackCommand}" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
                    </DockPanel>
                    <TextBlock Text="Reset password" Style="{StaticResource LoginStepTitle}"/>
                    <TextBlock Text="{Binding PasswordRequirementsText}"
                               FontSize="12" Style="{StaticResource LoginStepDescription}"/>

                    <TextBlock Text="New password" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorder}">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="NewPasswordBox" Grid.Column="0"
                                         Style="{StaticResource LoginPasswordBox}"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"/>
                            <TextBox x:Name="NewPasswordTextBox" Grid.Column="0"
                                     Style="{StaticResource LoginPasswordRevealTextBox}"
                                     Visibility="Collapsed"
                                     TextChanged="NewPasswordTextBox_TextChanged"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PasswordRevealButton}"
                                          Checked="NewPasswordReveal_Checked" Unchecked="NewPasswordReveal_Unchecked"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Confirm password" Style="{StaticResource LoginFieldLabel}"/>
                    <Border Style="{StaticResource LoginInputBorder}">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="0"
                                         Style="{StaticResource LoginPasswordBox}"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                            <TextBox x:Name="ConfirmPasswordTextBox" Grid.Column="0"
                                     Style="{StaticResource LoginPasswordRevealTextBox}"
                                     Visibility="Collapsed"
                                     TextChanged="ConfirmPasswordTextBox_TextChanged"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PasswordRevealButton}"
                                          Checked="ConfirmPasswordReveal_Checked" Unchecked="ConfirmPasswordReveal_Unchecked"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" Style="{StaticResource LoginMessage}"/>
                    <Button Content="Save new password" Style="{StaticResource LoginPrimaryButton}" Command="{Binding ResetPasswordCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
