<UserControl x:Class="Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HairSalonPOS.Wpf.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource ShellCardBorder}" Margin="0,0,16,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Categories" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding CategoryChips}" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Padding="12,8"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CategoryChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource ShellBorderBrush}" Margin="0,8,0,16"
                        Visibility="{Binding HasSubCategories, Converter={StaticResource BoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding SubCategoryChips}" DockPanel.Dock="Top" Margin="0,0,0,16"
                              Visibility="{Binding HasSubCategories, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Padding="12,6"
                                    Command="{Binding DataContext.SelectSubCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CategoryChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox DockPanel.Dock="Top" Margin="0,0,0,12"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBox}"
                         Tag="Search services..."
                         Visibility="{Binding IsBrowseMode, Converter={StaticResource BoolToVis}}"/>

                <TextBlock DockPanel.Dock="Top" Text="{Binding CatalogLeafLabel}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="No services yet. Add services in Master Files."
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,12"
                                   Visibility="{Binding ShowEmptyCatalogMessage, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding CatalogTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardMutedBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,12,12" Padding="10" MinWidth="130">
                                        <Button Style="{StaticResource CatalogTileButton}"
                                                Command="{Binding DataContext.AddTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="110"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Price, StringFormat=₱{0:N0}}" Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource ShellCardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Transaction Cart" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Customer" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Tag="Walk-in"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Staff" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <views:MultiSelectStaffDropdown StylistOptions="{Binding StylistOptions}"
                                                            SelectedStylistsLabel="{Binding SelectedStylistsLabel, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Checkout always visible at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="Checkout &amp; Print Receipt" Style="{StaticResource PrimaryCtaButton}"
                            Command="{Binding CheckoutCommand}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Reprint" Style="{StaticResource SecondaryButton}" Padding="12,8" MinHeight="36"
                                Command="{Binding ReprintLastReceiptCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="12,8" MinHeight="36"
                                Command="{Binding ClearCartCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Scrollable cart + totals + payment -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Cart}" Style="{StaticResource DataGridStyle}"
                                  MaxHeight="180" MinHeight="72" Margin="0,0,8,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding CartDisplayName}" Width="*"/>
                                <DataGridTemplateColumn Header="Staff" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding DataContext.SelectedStylists, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValue="{Binding StylistName, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Name"
                                                          DisplayMemberPath="Name"
                                                          Style="{StaticResource ModernComboBox}"
                                                          MinHeight="30"
                                                          Visibility="{Binding IsService, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="—"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{Binding IsService, Converter={StaticResource InverseBoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="48"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=₱{0:N2}}" Width="80"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=₱{0:N2}}" Width="90"/>
                                <DataGridTemplateColumn Header="" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="−" Style="{StaticResource SecondaryButton}" Padding="6,2" MinWidth="28" MinHeight="28" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.DecreaseLineQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="+" Style="{StaticResource SecondaryButton}" Padding="6,2" MinWidth="28" MinHeight="28"
                                                        Command="{Binding DataContext.IncreaseLineQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Subtotal" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding SubTotal, StringFormat=₱{0:N2}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding DiscountLabel}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding DiscountAmount, StringFormat=-₱{0:N2}}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Total" FontWeight="Bold" FontSize="18"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding Total, StringFormat=₱{0:N2}}" FontWeight="Bold" FontSize="18"/>
                        </Grid>

                        <TextBlock Text="Discount" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding DiscountOptions}"
                                  SelectedItem="{Binding SelectedDiscountOption}"
                                  DisplayMemberPath="DisplayLabel"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Payment method" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Cash" Command="{Binding SelectCashCommand}"
                                    MinHeight="36" MinWidth="90" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PaymentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="GCash" Command="{Binding SelectGcashCommand}"
                                    MinHeight="36" MinWidth="90">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PaymentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGcashSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Border Background="{DynamicResource NavActiveBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,4"
                                Visibility="{Binding ShowChangeCalculator, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Amount tendered" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Change" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ChangeAmount, StringFormat=₱{0:N2}}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
