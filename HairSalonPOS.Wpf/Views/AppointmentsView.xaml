<UserControl x:Class="Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="700">
    <Grid>
        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Button Content="← Back" Style="{StaticResource SecondaryButton}" Padding="10,6"
                            Command="{Binding CancelEditCommand}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="16"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="First name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditFirstName}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Last name" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditLastName}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Date" Style="{StaticResource SectionHeader}"/>
                        <DatePicker SelectedDate="{Binding EditAppointmentDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernDatePicker}"
                                    SelectedDateFormat="Short"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Service" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding ServiceNames}" SelectedItem="{Binding EditService}"
                                  IsEditable="True" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Time" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding SelectedDayBusinessHoursLabel}"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding HourOptions}"
                                      SelectedItem="{Binding EditHour}"
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource HourToDisplay}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding MinuteOptions}"
                                      SelectedItem="{Binding EditMinute}"
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Duration (mins)" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditDuration}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveAppointmentCommand}"
                            Visibility="{Binding IsAddingAppointment, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"/>
                    <Button Content="Update" Style="{StaticResource PrimaryButton}"
                            Command="{Binding UpdateAppointmentCommand}"
                            Visibility="{Binding IsAddingAppointment, Converter={StaticResource InverseBoolToVis}}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <Button Content="← Back" Style="{StaticResource SecondaryButton}" Padding="10,6"
                            Command="{Binding CancelViewCommand}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                    <TextBlock Text="Appointment details" FontWeight="SemiBold" FontSize="16"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>

                <Border Background="{DynamicResource NavActiveBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding ViewAppointment.CustomerName}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ViewAppointment.ServiceName}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,12,12">
                        <TextBlock Text="Date" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding ViewDateLabel}"
                                   FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Duration" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding ViewDurationLabel}"
                                   FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,12,0">
                        <TextBlock Text="Start time" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding ViewAppointment.TimeLabel}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="End time" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding ViewEndTimeLabel}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"
                            Command="{Binding EditAppointmentCommand}" CommandParameter="{Binding ViewAppointment}"/>
                    <Button Content="→ Point of Sale" Style="{StaticResource PrimaryButton}" Padding="14,8"
                            Command="{Binding ConvertToTransactionCommand}" CommandParameter="{Binding ViewAppointment}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="{Binding DateLabel}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="◀" Style="{StaticResource SecondaryButton}" Width="44" Command="{Binding PrevDayCommand}" Margin="0,0,4,0"/>
                        <Button Content="▶" Style="{StaticResource SecondaryButton}" Width="44" Command="{Binding NextDayCommand}" Margin="0,0,12,0"/>
                        <Button Content="+ Book" Style="{StaticResource PrimaryButton}" Command="{Binding BookCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,16"
                           Text="{Binding SelectedDayBusinessHoursLabel}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"/>
                <ItemsControl ItemsSource="{Binding Appointments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource NavActiveBackgroundBrush}" CornerRadius="10" Padding="14,10">
                                    <TextBlock>
                                        <Run Text="{Binding CustomerName}" FontWeight="SemiBold"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding ServiceName}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding DurationMinutes}"/>
                                        <Run Text=" mins)"/>
                                    </TextBlock>
                                </Border>
                                <Button Grid.Column="2" Content="View" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6"
                                        Command="{Binding DataContext.ViewAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="3" Content="Edit" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6"
                                        Command="{Binding DataContext.EditAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="4" Content="Delete" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6"
                                        Command="{Binding DataContext.DeleteAppointmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="5" Content="→ Point of Sale" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ConvertToTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
