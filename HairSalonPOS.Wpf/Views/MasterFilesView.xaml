<UserControl x:Class="Views.MasterFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HairSalonPOS.Wpf.Views"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1000">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Master Files" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Manage categories, services, products, staff, and discounts" FontSize="14"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,12"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Categories" Command="{Binding ShowCategoriesCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCategories}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Services" Command="{Binding ShowServicesCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServices}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Products" Command="{Binding ShowProductsCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProducts}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Staff" Command="{Binding ShowStaffCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStaff}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Discounts" Command="{Binding ShowDiscountsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDiscounts}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipActiveBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>

        <Grid>
            <ContentControl Visibility="{Binding IsCategories, Converter={StaticResource BoolToVis}}">
                <views:ServicesView DataContext="{Binding Services}"/>
            </ContentControl>
            <ContentControl Visibility="{Binding IsServices, Converter={StaticResource BoolToVis}}">
                <views:ServicesView DataContext="{Binding Services}"/>
            </ContentControl>

            <!-- Products catalog -->
            <Grid Visibility="{Binding IsProducts, Converter={StaticResource BoolToVis}}">
                <Grid DataContext="{Binding Products}">
                <Border Style="{StaticResource CardBorder}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button Content="← Back" Style="{StaticResource SecondaryButton}" Padding="10,6"
                                        Command="{Binding CancelEditCommand}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="16"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Product name" Style="{StaticResource SectionHeader}"/>
                                    <TextBox Text="{Binding EditName}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Brand" Style="{StaticResource SectionHeader}"/>
                                    <TextBox Text="{Binding EditBrand}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Price" Style="{StaticResource SectionHeader}"/>
                                    <TextBox Text="{Binding EditPrice}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Cost" Style="{StaticResource SectionHeader}"/>
                                    <TextBox Text="{Binding EditCost}" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Category" Style="{StaticResource SectionHeader}"/>
                                    <ComboBox ItemsSource="{Binding EditCategoryOptions}" SelectedItem="{Binding EditCategory}" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Subcategory" Style="{StaticResource SectionHeader}"/>
                                    <ComboBox ItemsSource="{Binding EditSubCategoryOptions}" SelectedItem="{Binding EditSubCategory}" Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="Save product" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProductCommand}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Products" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding ShowArchivedLabel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding ToggleShowArchivedCommand}"/>
                                <Button Content="+ Add product" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddProductCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                                                        <Run Text="{Binding Brand, Mode=OneWay}"/>
                                                        <Run Text=" • ₱"/>
                                                        <Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                        <Run Text=" • "/>
                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource StatusOkBadge}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="Edit" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="3" Padding="12,6" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ArchiveProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Content="Archive">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="3" Padding="12,6" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.UnarchiveProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Content="Restore">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Grid.Column="4" Content="Delete" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>
            </Grid>

            <ContentControl Visibility="{Binding IsStaff, Converter={StaticResource BoolToVis}}">
                <views:StaffView DataContext="{Binding Staff}"/>
            </ContentControl>
            <ContentControl Visibility="{Binding IsDiscounts, Converter={StaticResource BoolToVis}}">
                <views:DiscountsView DataContext="{Binding Discounts}"/>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
