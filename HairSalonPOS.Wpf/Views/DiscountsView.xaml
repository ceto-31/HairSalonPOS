<UserControl x:Class="Views.DiscountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="700">
    <Grid>
        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Button Content="← Back" Style="{StaticResource SecondaryButton}" Padding="10,6"
                            Command="{Binding CancelEditCommand}" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="16"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Code" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditCode}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Type" Style="{StaticResource SectionHeader}"/>
                        <ComboBox ItemsSource="{Binding DiscountTypes}" SelectedItem="{Binding EditType}" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Value" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditValue}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding EditDescription}" Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>
                <CheckBox Content="Senior / PWD (BIR compliant)" IsChecked="{Binding EditSeniorPwd}" Margin="0,0,0,12"/>
                <Button Content="Save promo" Style="{StaticResource PrimaryButton}" Command="{Binding SavePromoCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}"
                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Discounts" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding ShowArchivedLabel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding ToggleShowArchivedCommand}"/>
                        <Button Content="+ New promo" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewPromoCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}"/>
                <ItemsControl ItemsSource="{Binding Discounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardMutedBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBadgeBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="Expiring">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBadgeBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusLabel}" Value="Archived">
                                                        <Setter Property="Background" Value="{DynamicResource CardMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Edit" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                            Command="{Binding DataContext.EditDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="3" Padding="12,6" Margin="0,0,8,0" Content="Archive"
                                            Command="{Binding DataContext.ArchiveDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="3" Padding="12,6" Margin="0,0,8,0" Content="Restore"
                                            Command="{Binding DataContext.UnarchiveDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="4" Content="Delete" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                            Command="{Binding DataContext.DeleteDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
