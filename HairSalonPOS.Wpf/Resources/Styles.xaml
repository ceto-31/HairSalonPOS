        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MaxHeight" Value="44"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoginInlineTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Height="44">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoginInlinePasswordBox" TargetType="PasswordBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="PasswordChar" Value="&#x2022;"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="12,0,8,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid Height="44">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Login / recovery form - uniform 44px fields -->
    <Style x:Key="LoginTextBox" TargetType="TextBox" BasedOn="{StaticResource LoginInlineTextBox}">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="LoginFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="LoginFieldError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LoginCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Padding" Value="28"/>
    </Style>

    <Style x:Key="LoginHeaderBlock" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="LoginStepSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="LoginStepTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="LoginStepDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="LoginBackRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="LoginInputBorderCompact" TargetType="Border" BasedOn="{StaticResource LoginInputBorder}">
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <Style x:Key="LoginPasswordFieldBorder" TargetType="Border" BasedOn="{StaticResource LoginInputBorder}"/>

    <Style x:Key="LoginPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource LoginInlinePasswordBox}"/>

    <Style x:Key="LoginPasswordRevealTextBox" TargetType="TextBox" BasedOn="{StaticResource LoginInlineTextBox}">
        <Setter Property="Padding" Value="12,0,8,0"/>
    </Style>

    <Style x:Key="LoginMessage" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="LoginLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="DashboardLinkButton" TargetType="Button" BasedOn="{StaticResource LoginLinkButton}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DashboardQuickActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Height" Value="88"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="DashboardKpiWell" TargetType="Border">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource AvatarBackgroundBrush}"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="DashboardKpiIcon" TargetType="Path">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DashboardKpiImage" TargetType="Image">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>

    <Style x:Key="DashboardQuickIcon" TargetType="Path" BasedOn="{StaticResource DashboardKpiIcon}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Geometry x:Key="IconSalesGeometry">M3,16 L8.5,10.5 L13,14.5 L21,6 M21,6 L15.5,6 M21,6 L21,11.5</Geometry>
    <Geometry x:Key="IconReceiptGeometry">M7,3 H17 C18.1,3 19,3.9 19,5 V21 L12,18.2 L5,21 V5 C5,3.9 5.9,3 7,3 Z M8.5,8 H15.5 M8.5,11.5 H15.5 M8.5,15 H13</Geometry>
    <Geometry x:Key="IconBoxGeometry">M4,8 L12,4 L20,8 V17 L12,21 L4,17 Z M4,8 L12,12 L20,8 M12,12 V21</Geometry>
    <Geometry x:Key="IconCalendarGeometry">M6,5 H18 C19.1,5 20,5.9 20,7 V19 C20,20.1 19.1,21 18,21 H6 C4.9,21 4,20.1 4,19 V7 C4,5.9 4.9,5 6,5 Z M8,3 V7 M16,3 V7 M4,10 H20</Geometry>
    <Geometry x:Key="IconBagGeometry">M7,8 V20 C7,21.1 7.9,22 9,22 H15 C16.1,22 17,21.1 17,20 V8 M6,8 H18 M9,8 V6 C9,4.3 10.3,3 12,3 C13.7,3 15,4.3 15,6 V8</Geometry>
    <Geometry x:Key="IconBarsGeometry">M5,19 V11 M10,19 V6 M15,19 V13 M20,19 V8 M3,19 H21</Geometry>

    <Style x:Key="ThemeToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default foreground on dark/light surfaces (theme-aware via TextBrush).
         TextBlock has no implicit Foreground so labels inside Buttons inherit the button's Foreground (e.g. white on primary actions). -->
    <Style TargetType="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

</ResourceDictionary>
