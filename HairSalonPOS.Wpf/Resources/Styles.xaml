                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush" Color="#6B4423"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#4A3228"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#3D2B1F"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FAF7F4"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardMutedBrush" Color="#F3EBE3"/>
    <SolidColorBrush x:Key="TextBrush" Color="#3D2B1F"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8B7355"/>
    <SolidColorBrush x:Key="AlertBrush" Color="#F5E6C8"/>
    <SolidColorBrush x:Key="LowStockBrush" Color="#F5D5D5"/>
    <SolidColorBrush x:Key="ShellHeaderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#E8DDD0"/>
    <SolidColorBrush x:Key="DrawerBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DrawerBorderBrush" Color="#D4C4B0"/>
    <SolidColorBrush x:Key="ShellIconBrush" Color="#3D2B1F"/>
    <SolidColorBrush x:Key="ShellHoverBrush" Color="#EDE4D8"/>
    <SolidColorBrush x:Key="HeaderStatBrush" Color="#5C4033"/>
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#F8F4F0"/>
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#EDE4D8"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E0D2C2"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#5C4033"/>
    <SolidColorBrush x:Key="DrawerNavForegroundBrush" Color="#3D2B1F"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D4C4B0"/>
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChipForegroundBrush" Color="#5C4033"/>
    <SolidColorBrush x:Key="ChipBorderBrush" Color="#D4C4B0"/>
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#F5EDE4"/>
    <SolidColorBrush x:Key="CatalogTileHoverBrush" Color="#F0E6DA"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#EDE4D8"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E8DDD0"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#A52A2A"/>
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#E8F0E0"/>
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#F5E6C8"/>
    <SolidColorBrush x:Key="ErrorBadgeBrush" Color="#F5D5D5"/>
    <SolidColorBrush x:Key="AvatarBackgroundBrush" Color="#EDE4D8"/>
    <SolidColorBrush x:Key="AvatarForegroundBrush" Color="#5C4033"/>
    <SolidColorBrush x:Key="NavButtonForegroundBrush" Color="#8B7355"/>
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#5C4033"/>
    <SolidColorBrush x:Key="CtaBrush" Color="#6B4423"/>
    <SolidColorBrush x:Key="CtaDarkBrush" Color="#4A3228"/>
    <SolidColorBrush x:Key="CtaForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkEditBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="LinkEditHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="LinkDeleteBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="LinkDeleteHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="LinkStockInBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="LinkStockInHoverBrush" Color="#166534"/>
    <SolidColorBrush x:Key="SearchInputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderFocusBrush" Color="#6B4423"/>
    <SolidColorBrush x:Key="ChipActiveBackgroundBrush" Color="#6B4423"/>
    <SolidColorBrush x:Key="ChipInactiveForegroundBrush" Color="#5C4033"/>
    <SolidColorBrush x:Key="DialogPrimaryBrush" Color="#4E342E"/>
    <SolidColorBrush x:Key="DialogPrimaryHoverBrush" Color="#5D4037"/>
    <SolidColorBrush x:Key="DialogPrimaryPressedBrush" Color="#3E2723"/>
    <SolidColorBrush x:Key="SoftGoldBrush" Color="#C8A97E"/>
    <SolidColorBrush x:Key="ChartFillBrush" Color="#C8A97E"/>
    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="InventorySelectedTintBrush" Color="#F5EDE4"/>
    <SolidColorBrush x:Key="InventorySelectedAccentBrush" Color="#6B4423"/>

    <!-- ComboBox dropdown item -->
    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ShellHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryCtaButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CtaBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource CtaForegroundBrush}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource CtaDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridActionEditButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LinkEditBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkEditHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridActionDeleteButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LinkDeleteBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkDeleteHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridActionStockInButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LinkStockInBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkStockInHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridActionStockOutButton" TargetType="Button" BasedOn="{StaticResource GridActionDeleteButton}"/>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StockInCtaButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource LinkStockInBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LinkStockInHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StockOutCtaButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource LinkDeleteBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LinkDeleteHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForegroundBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
